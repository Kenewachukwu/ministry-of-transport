{
  "name": "mot-website-prototype",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:db": "LOCAL_DB=pglite next dev",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/db-migrate.ts",
    "db:seed": "tsx --conditions=react-server scripts/db-seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "docs:build": "tsx scripts/build-docs.ts",
    "admin:bootstrap": "tsx --conditions=react-server scripts/admin-bootstrap.ts",
    "db:reset-local": "rm -rf .data/pglite"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@vercel/blob": "2.8.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.12",
    "lucide-react": "^1.32.0",
    "motion": "^13.1.0",
    "next": "16.3.1",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@next/env": "16.3.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "4.1.12"
  }
}
