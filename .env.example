# Copy to .env.local for local work, or add these in Vercel → Project → Settings → Environment Variables.
# Nothing here is required to run the public site: with no DATABASE_URL it serves the content in src/content/*.

# --- Database (Neon Postgres, added from the Vercel Marketplace) -------------------------------
DATABASE_URL=
# Optional direct (non-pooled) connection, used only by `npm run db:migrate`.
DATABASE_URL_UNPOOLED=

# --- Admin sign-in -----------------------------------------------------------------------------
# 32+ random bytes, base64:  openssl rand -base64 32     (use a different value per environment)
SESSION_SECRET=
# Public origin used in invite / reset emails, e.g. https://www.transportation.gov.ng
SITE_URL=
# Used by `npm run admin:bootstrap` to create the first super administrator.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=

# --- Email (Resend) ----------------------------------------------------------------------------
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "Federal Ministry of Transportation <no-reply@transportation.gov.ng>"
EMAIL_FROM=
EMAIL_REPLY_TO=

# --- File uploads (Vercel Blob; create a PUBLIC store) -----------------------------------------
BLOB_READ_WRITE_TOKEN=

# --- Local development only ---------------------------------------------------------------------
# LOCAL_DB=pglite   uses an embedded database under .data/ (see `npm run dev:db`); no cloud account needed.
